{
  "name": "@calculafiscal/regras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cenarios": {
      "types": "./dist/cenarios.d.ts",
      "default": "./dist/cenarios.js"
    },
    "./tabela": {
      "types": "./dist/tabela.d.ts",
      "default": "./dist/tabela.js"
    }
  },
  "scripts": {
    "gerar": "node scripts/gerar-pacote.mjs",
    "build": "node scripts/gerar-pacote.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/gerar-pacote.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/gerar-pacote.mjs && vitest run"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^4.6.7",
    "@calculafiscal/motor-fiscal": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}

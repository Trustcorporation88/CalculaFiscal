# Copie para apps/web/.env.local. Nunca faça commit de valores reais.
# Públicos (vão para o navegador):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SENTRY_DSN=
# Servidor:
SITE_URL=http://localhost:3000
APP_ENV=local
SENTRY_DSN=
# Secretos (só no servidor; em staging/produção ficam nas variáveis do Railway):
SUPABASE_SECRET_KEY=
DATABASE_URL=
SENTRY_AUTH_TOKEN=
